Algoritmo Contador
	// Definir variables
	Definir NumeroUsuario, x Como Entero
	NumeroUsuario = 0
	x = 0
	// Pedir número por pantalla
	Escribir "Introduce un número a contar:"
	Leer NumeroUsuario
	// Ejecución del bucle
	Para x = 1 Hasta NumeroUsuario Hacer
		Escribir x
		Esperar 1 segundo
	FinPara
	
FinAlgoritmo
